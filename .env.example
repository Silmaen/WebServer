# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Server
SERVER_PORT=8000
SERVER_PATH_MEDIA=./docker_data/media
SERVER_DNS=8.8.8.8
MONITORING_DOMAINE_DEFAUT=home.lan

# PostgreSQL
SERVER_PATH_PGDB=./docker_data/pgdb
DB_NAME=bob
DB_USER=bobette
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=bob
POSTGRES_USER=bobette
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Email
EMAIL_HOST=127.0.0.1
EMAIL_PORT=587
EMAIL_HOST_USER=site@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True

# ===========================================================================
# La console de la flotte et la surveillance réseau, déplacées ici depuis
# network_monitor. Voir _ops/docs/console-merge.md dans home-server-stacks.
# ===========================================================================

# La liste des machines du lab, montée en lecture seule. Pointer vers le checkout
# de home-server-stacks sur la même machine : ce fichier reste la source de vérité,
# busybox awk le lit aussi sur le routeur.
INVENTORY_FILE=/srv/home-server-stacks/_common/inventory.conf

# Le jeton porteur que les machines envoient avec leur rapport horaire. Partagé par
# `_common/ansible/run.sh converge.yml`, qui lit _ops/state/console_token. Vide
# signifie que tout POST est refusé : un secret non défini ne doit jamais se lire
# comme « aucun secret requis ».
REPORT_TOKEN=

# Deux runs horaires manqués, pas un.
STALE_AFTER_SECONDS=7800
FLEET_REPORT_RETENTION_DAYS=90
MONITORING_RESULT_RETENTION_DAYS=30

# Où répond wud : c'est lui qui alimente la colonne « images en retard ».
WUD_URL=http://selene.argawaen.net:8082

# Publier une approbation : un verbe sur un topic que cette app peut écrire et pas
# lire. Aucune commande n'est jamais transmise -- voir apps/fleet/ntfy.py.
NTFY_URL=http://selene.argawaen.net:8081
NTFY_WAKE_TOPIC=homelab-wake
NTFY_TOKEN=

# Ports publiés sur la loopback pour le scanner (network_mode: host).
REDIS_PORT=6379

# SSO authentik. Le site est volontairement public -- un CV, des projets -- donc
# authentik ne peut pas filtrer le vhost : ça filtrerait aussi ça. C'est de l'OIDC
# dans Django, avec le ModelBackend local gardé en secours si authentik tombe.
# Laisser OIDC_RP_CLIENT_ID vide désactive le SSO.
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.argawaen.net/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.argawaen.net/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.argawaen.net/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.argawaen.net/application/o/argawaen/jwks/
OIDC_OP_LOGOUT_ENDPOINT=https://auth.argawaen.net/application/o/argawaen/end-session/
OIDC_REDIRECT_URL=https://www.argawaen.net/oidc/callback/
OIDC_ADMIN_GROUP=network-monitor-admins
OIDC_VIEWER_GROUP=network-monitor-viewers
